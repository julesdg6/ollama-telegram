TOKEN=0123
ADMIN_IDS=000,111
USER_IDS=000,111
ALLOW_ALL_USERS_IN_GROUPS=0
GROUP_IDS=
INITMODEL=llama-2
TIMEOUT=3000

# Vision model used when a photo is sent to the bot (must be pulled in Ollama)
# Set to empty string to disable automatic vision model switching
VISION_MODEL=llama3.2-vision

# UNCOMMENT ONE OF THE FOLLOWING LINES (hostname only, without http:// prefix):
# OLLAMA_BASE_URL=localhost # to run ollama without docker, using run.py
# OLLAMA_BASE_URL=ollama-server # to run ollama in a docker container 
# OLLAMA_BASE_URL=host.docker.internal # to run ollama locally
# OLLAMA_BASE_URL=192.168.1.100 # example: use IP address of your ollama host

# Log level
# https://docs.python.org/3/library/logging.html#logging-levels
LOG_LEVEL=DEBUG
